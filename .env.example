# Defaults to deterministic offline prose/table parsing. No key is needed.
FINEPRINT_LLM_PROVIDER=fallback
# For live calls choose openai, anthropic, bedrock, or deepseek, then restart the server.
# FINEPRINT_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# FINEPRINT_DEEPSEEK_MODEL=deepseek-v4-pro
# Alternative DeepSeek model: deepseek-flash. FINEPRINT_LLM_MODEL does not override it.
# Bedrock: install optional boto3, choose an enabled model/inference profile with
# Converse forced-tool support, and use the normal AWS credential chain.
# FINEPRINT_LLM_MODEL=your-enabled-bedrock-model-or-inference-profile-id
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Schema/evidence validation attempts, bounded 1..5. Default 3.
FINEPRINT_LLM_ATTEMPTS=3
# Read timeout per HTTP attempt. Transient transport failures retry once
# independently of schema/evidence retries. DeepSeek starts at 32,768 output
# tokens and retries incomplete JSON with up to 65,536 tokens.
FINEPRINT_LLM_TIMEOUT=300
# This file documents variables; the app does not auto-load .env files.
